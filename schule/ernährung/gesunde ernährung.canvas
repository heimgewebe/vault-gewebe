{
	"nodes":[
		{"id":"n1","type":"text","text":"Gesunde Ernährung","x":0,"y":0,"width":300,"height":120,"color":"#1E88E5"},
		{"id":"n2","type":"text","text":"Zieldefinition\n- Nährstoffdeckung\n- Prävention\n- Leistungsfähigkeit\n- Langlebigkeit","x":-600,"y":-200,"width":300,"height":200,"color":"#3949AB"},
		{"id":"n3","type":"text","text":"Makronährstoffe\n- Kohlenhydrate\n- Proteine\n- Fette","x":-600,"y":200,"width":300,"height":200,"color":"#FB8C00"},
		{"id":"n4","type":"text","text":"Mikronährstoffe\n- Vitamine\n- Mineralstoffe\n- Spurenelemente\n- Phytonährstoffe","x":-200,"y":300,"width":320,"height":200,"color":"#00ACC1"},
		{"id":"n5","type":"text","text":"Stoffwechsel & Regulation\n- Blutzucker\n- Insulinsensitivität\n- Mikrobiom\n- Entzündung","x":300,"y":200,"width":320,"height":220,"color":"#43A047"},
		{"id":"n6","type":"text","text":"Lebensmittelqualität\n- Verarbeitungsgrad (NOVA)\n- Regionalität\n- Saisonalität\n- Bio vs konventionell","x":700,"y":0,"width":320,"height":220,"color":"#FDD835"},
		{"id":"n7","type":"text","text":"Essverhalten\n- Mahlzeitenfrequenz\n- Achtsamkeit\n- Sättigung\n- Emotionales Essen","x":300,"y":-250,"width":320,"height":220,"color":"#FDD835"},
		{"id":"n8","type":"text","text":"Ernährungsformen\n- Mediterran\n- Vegetarisch\n- Vegan\n- Low-Carb\n- Intervallfasten","x":-200,"y":-350,"width":320,"height":240,"color":"#FDD835"},
		{"id":"n9","type":"text","text":"Individualisierung\n- Lebensphase\n- Sport\n- Erkrankungen\n- Genetik","x":700,"y":-300,"width":320,"height":220,"color":"#3949AB"},
		{"id":"n10","type":"text","text":"Risiken\n- Mangel\n- Überernährung\n- Essstörungen\n- Supplement-Überdosierung","x":1000,"y":250,"width":320,"height":220,"color":"#E53935"},
		{"id":"n11","type":"text","text":"Nachhaltigkeit\n- CO2\n- Tierwohl\n- Ressourcen","x":1000,"y":-200,"width":320,"height":180,"color":"#6D4C41"},
		{"id":"n12","type":"text","text":"Evidenz & Bewertung\n- RCTs\n- Beobachtungsstudien\n- Metaanalysen\n- Interessenkonflikte","x":-900,"y":0,"width":320,"height":220,"color":"#8E24AA"},
		{"id":"n13","type":"text","text":"Frühe Regulation & Lernen\n- Säugling: Hunger/Durst/Sättigung (Innenreize)\n- Mit Alter: Lernen/Gewohnheit übernimmt\n- Vorbildlernen: Eltern/Geschwister/Erzieher\n- Umfeld prägt Lebensmittelwahl","x":-350,"y":-520,"width":360,"height":260,"color":"#FDD835"},
		{"id":"n14","type":"text","text":"Energie & Brennwert\n- kcal ↔ kJ (Faust: 1 kcal ≈ 4,2 kJ)\n- Brennwert = Energiegehalt\n- Richtwert Alltag: ca. 10.000 kJ/Tag (Faustregel)\n- Lebensmittelkennzeichnung lesen","x":350,"y":520,"width":360,"height":250,"color":"#43A047"},
		{"id":"n15","type":"text","text":"Grundumsatz vs Leistungsumsatz\n- Grundumsatz: Atmung, Herz, Gehirn, Temperatur (auch im Schlaf)\n- Erhöht: Wachstum, Schwangerschaft, Stillzeit\n- Leistungsumsatz: Aktivität/Arbeit/Sport\n- Aktivität steigert Energieverbrauch","x":750,"y":520,"width":380,"height":260,"color":"#43A047"},
		{"id":"n16","type":"text","text":"Ballaststoffe & Sättigung\n- Unverdaulich\n- Fördern Sättigungsgefühl\n- Regen Darmtätigkeit an\n- Quellen: Vollkorn, Gemüse, Obst, Kartoffeln","x":-950,"y":280,"width":340,"height":220,"color":"#FB8C00"},
		{"id":"n17","type":"text","text":"Essenzielle Fette\n- Mehrfach ungesättigte Fettsäuren (essenziell)\n- Zellwände, Mitochondrien, Hormone\n- Fett nötig für Aufnahme fettlöslicher Vitamine\n- Öle vs tierische Fette (maßvoll)","x":1050,"y":40,"width":360,"height":240,"color":"#FB8C00"},
		{"id":"n18","type":"text","text":"Eiweiß & Aminosäuren\n- Spaltung in Aminosäuren\n- Essenzielle Aminosäuren müssen zugeführt werden\n- Tierisch oft 'hochwertiger'\n- Funktionen: Baustoff, Immunabwehr, Transport","x":-950,"y":520,"width":340,"height":230,"color":"#FB8C00"},
		{"id":"n19","type":"text","text":"Vitamine: wasser- vs fettlöslich\n- 13 Vitamine\n- Fettlöslich: speicherbar, Überdosierung riskant\n- Wasserlöslich: Überschuss meist Ausscheidung\n- Zubereitung: Hitze/Licht/Sauerstoff beachten","x":-200,"y":560,"width":380,"height":260,"color":"#00ACC1"},
		{"id":"n20","type":"text","text":"Mineralstoffe & Spurenelemente\n- Mengenelemente: Ca, P, Mg; Na/K für Nerven/Muskeln\n- Spurenelemente: Fe, Zn, Cu, I, F\n- Mangel → typische Symptome (z. B. Anämie bei Eisenmangel)","x":150,"y":780,"width":420,"height":240,"color":"#00ACC1"},
		{"id":"n21","type":"text","text":"Wasserhaushalt\n- Körper: ca. 50–60% Wasser\n- Funktionen: Baustoff, Lösung, Transport, Wärmeregulation\n- Bilanz: Zufuhr über Getränke + Nahrung\n- Verlust: Urin, Schweiß, Atmung, Stuhl","x":700,"y":-520,"width":360,"height":260,"color":"#43A047"},
		{"id":"n22","type":"text","text":"Portionsmaß & Pyramide (praxisnah)\n- Pyramide: Getränke > Obst/Gemüse > Getreide/Kartoffeln > Milchprodukte > Fleisch/Fisch/Ei > Fette > Süßes\n- Handmaß: Portion = eigene Hand (skalierbar)\n- Ampelidee: reichlich / mäßig / sparsam","x":1050,"y":-520,"width":380,"height":280,"color":"#FDD835"},
		{"id":"n23","type":"text","text":"Nahrungsergänzung: Nutzen vs Risiko\n- Für Gesunde meist überflüssig\n- Risiko: Überdosierung (v. a. fettlösliche Vitamine)\n- Sinnvoll nur für Risikogruppen nach ärztlicher Anweisung","x":1350,"y":520,"width":380,"height":220,"color":"#E53935"},
		{"id":"n24","type":"text","text":"Makro-Verteilung (Faust)\n- Empfehlung Erwachsene: 55% KH / 30% Fett / 15% Eiweiß\n- Energie pro g: KH 17,2 kJ; Eiweiß 17,2 kJ; Fett 39 kJ\n- Werte variieren nach Alter/Lebenslage","x":-600,"y":520,"width":360,"height":240,"color":"#9E9E9E"}
	],
