		{"id":"quali","type":"text","text":"🛡️ Qualität & Schutz\n• Qualitätsmanagement\n• Hilfeplangespräche\n• Beschwerdesystem\n• Kinderschutz (§8a, §79a)","x":90,"y":640,"width":340,"height":200,"color":"6"},
		{"id":"alltag","type":"text","text":"🏠 Betreuungsalltag","x":250,"y":-240,"width":300,"height":120,"color":"3"},
