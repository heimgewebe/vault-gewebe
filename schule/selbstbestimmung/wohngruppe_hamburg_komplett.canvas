{
	"nodes":[
		{"id":"center","type":"text","text":"🧠 Pädagogisch betreute Wohngruppe\nHamburg","x":0,"y":0,"width":360,"height":160,"color":"1"},
		{"id":"ziel","type":"text","text":"🎯 Zielgruppe & Zielsetzung\n• Kinder/Jugendliche (6–12, ggf. älter)\n• Belastungen, Beziehungsabbrüche\n• Rückführung ODER Verselbstständigung\n• Hilfe nach §34 SGB VIII","x":-300,"y":-460,"width":340,"height":220,"color":"2"},
		{"id":"recht","type":"text","text":"⚖️ Recht & Aufnahme\n• Jugendamt entscheidet\n• Hilfeplanung zentral\n• Ausschluss: Suizidalität, schwere Psychosen, akute Sucht\n• Aufnahme durch ASD / Notdienst","x":-560,"y":-160,"width":340,"height":220,"color":"2"},
		{"id":"eltern","type":"text","text":"👨‍👩‍👧 Elternarbeit\n• Beratung & Einbindung\n• Besuchsregelung\n• Rückführung vorbereiten\n• Transparenz","x":-560,"y":120,"width":340,"height":200,"color":"4"},
		{"id":"flank","type":"text","text":"📊 Flankierende Leistungen\n• Dokumentation (Tagebuch)\n• Hilfeplangespräche (§36)\n• Kooperation Jugendamt\n• Supervision & Fortbildung","x":-560,"y":360,"width":340,"height":220,"color":"5"},
		{"id":"betrieb","type":"text","text":"⚙️ Betriebsstruktur\n• 9–11 Plätze\n• 24h Betreuung\n• Fachkräfte + Hauswirtschaft\n• 1:1,73 / 1:2,28","x":-390,"y":640,"width":340,"height":220,"color":"5"},
